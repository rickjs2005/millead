model FinanceSettings {
  id                 String    @id @default(cuid())
  organizationId     String    @unique @map("organization_id")
  usdToBrlRate       Decimal   @default(5.30) @map("usd_to_brl_rate") @db.Decimal(8, 4)
  /// Se true, `usdToBrlRate` e atualizado sozinho (lazy, no read) a partir
  /// de uma API de cotacao quando `usdRateUpdatedAt` for null ou tiver mais
  /// de 24h. Editar `usdToBrlRate` na mao desliga isso automaticamente
  /// (a aplicacao seta false) -- edicao manual sempre vence o automatico
  /// ate o usuario religar.
  usdRateAuto        Boolean   @default(true) @map("usd_rate_auto")
  /// Timestamp da ultima atualizacao (manual ou automatica) de
  /// `usdToBrlRate` -- usado pra decidir se a cotacao automatica esta
  /// "velha" (> 24h) e precisa buscar de novo.
  usdRateUpdatedAt   DateTime? @map("usd_rate_updated_at")
  defaultHourlyRate  Decimal   @default(120) @map("default_hourly_rate") @db.Decimal(12, 2)
  supportReservePct  Decimal   @default(10) @map("support_reserve_pct") @db.Decimal(5, 2)
  defaultMarginPct   Decimal   @default(30) @map("default_margin_pct") @db.Decimal(5, 2)
  activeClientsCount Int       @default(1) @map("active_clients_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("finance_settings")
}

model ProjectProduct {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  name           String
  priceMin       Decimal  @map("price_min") @db.Decimal(12, 2)
  priceMax       Decimal  @map("price_max") @db.Decimal(12, 2)
  baseHours      Int?     @map("base_hours")
  description    String?
  order          Int      @default(0)
