model PricingEstimateCost {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  estimateId     String           @map("estimate_id")
  subscriptionId String?          @map("subscription_id")
  label          String
  amount         Decimal          @db.Decimal(12, 2)
  currency       CostCurrency     @default(BRL)
  billingCycle   CostBillingCycle @default(MONTHLY) @map("billing_cycle")
  isOneTime      Boolean          @default(false) @map("is_one_time")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estimate     PricingEstimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  subscription CostSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, estimateId])
  @@map("pricing_estimate_costs")
}

// ---------------------------------------------------------------------------
// Módulo Financeiro (Fase 5) -- Créditos por assinatura e consumo.
// ---------------------------------------------------------------------------

/// Lançamento de consumo de créditos de uma assinatura com `creditsIncluded`
/// (ex.: Higgsfield) -- permite acompanhar quanto do plano mensal já foi
/// usado, opcionalmente atribuído a um Company/cliente específico.
model CostUsageEntry {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  subscriptionId String   @map("subscription_id")
  companyId      String?  @map("company_id")
  credits        Int
  usedAt         DateTime @map("used_at")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  // Snapshot do preço/crédito em BRL no momento do lançamento (mensal BRL da
  // assinatura ÷ creditsIncluded, na taxa de câmbio de então). Null nos
  // lançamentos antigos (pré-migration) e quando a assinatura não tinha
  // creditsIncluded no momento -- nesses casos o resumo cai no fallback
  // derivado ao vivo. Sem isso, mudar o preço da assinatura ou o câmbio
  // reescreve retroativamente o custo de meses já fechados.
  unitPriceBrl   Decimal? @map("unit_price_brl") @db.Decimal(14, 6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription CostSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId, usedAt])
  @@index([organizationId, subscriptionId])
  @@map("cost_usage_entries")
}

// ---------------------------------------------------------------------------
// Automação pós-fechamento (contrato assinado -> lead ganho, recebimentos,
// briefing, projeto, tarefas).
//
// Três tabelas de execução em vez de uma porque cada uma responde a uma
// pergunta diferente e com uma trava de unicidade diferente:
//   - AutomationExecution: "este contrato já disparou a automação?"
//     (unique organizationId+eventType+contractId)
//   - AutomationStep: "esta ETAPA já rodou nesta execução?"
//     (unique executionId+key) -- é o que faz o reprocessamento rodar só o
//     que falta
//   - AutomationArtifact: "este ARTEFATO já foi criado?"
//     (unique executionId+key) -- é o que impede tarefa/briefing/projeto
//     duplicado quando o webhook é reenviado, e é de onde a tela do contrato
//     tira os links pro que foi criado
//
// Um `result Json` no step cobriria a leitura mas não daria trava de banco
// nenhuma -- e é exatamente a trava que o reenvio de webhook exige.
// ---------------------------------------------------------------------------

enum AutomationEventType {
  /// Único evento hoje. A entidade de origem deste evento é o Contract
  /// (coluna `contract_id`, obrigatória). Um evento futuro com outra origem
  /// ganha a própria coluna anulável, em vez de um par sourceType/sourceId
  /// genérico sem FK.
  CONTRACT_SIGNED

  @@map("automation_event_type")
}

enum AutomationTrigger {
  /// Disparada pelo webhook de assinatura.
  WEBHOOK
  /// Reprocessamento pedido por um usuário na tela do contrato.
  MANUAL

  @@map("automation_trigger")
}

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED

  @@map("automation_execution_status")
}

enum AutomationStepKey {
  LEAD_WON
  RECEIVABLES
  BRIEFING
  PROJECT
  TASKS

  @@map("automation_step_key")
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  /// Desligada de propósito na configuração, ou não aplicável (ex.: contrato
  /// sem lead) -- não conta como pendência.
  SKIPPED
  /// Faltou configuração obrigatória: a etapa NÃO adivinhou valor, criou uma
  /// tarefa pro responsável resolver à mão. Conta como execução parcial.
  NEEDS_ACTION
  FAILED

  @@map("automation_step_status")
}

enum AutomationArtifactType {
  LEAD
  RECEIVABLE_PLAN
  BRIEFING
  PROJECT_CHECKLIST
  TASK

  @@map("automation_artifact_type")
}

/// Configuração por organização da automação pós-fechamento.
///
/// `installmentCount`/`entryDueDays`/`firstInstallmentDueDays` são anuláveis
/// SEM default de propósito: são decisão financeira do dono. Sem valor
/// salvo, a etapa de recebimentos vira pendência com tarefa -- nunca chuta
/// "2 parcelas em 30 dias" no lugar de quem vende.
model PostSaleAutomationSettings {
  id                      String                @id @default(cuid())
  organizationId          String                @unique @map("organization_id")
  /// Chave-mestra. Default false: ligar a automação é decisão explícita --
  /// nenhuma organização existente muda de comportamento com a migration.
  enabled                 Boolean               @default(false)
  /// Estágio do pipeline marcado como ganho pra onde o lead é movido.
  wonStageId              String?               @map("won_stage_id")
  briefingTemplateKey     String?               @map("briefing_template_key")
  projectType             ProjectChecklistType? @map("project_type")
  /// Responsável padrão por projeto, briefing e tarefas geradas.
  defaultOwnerId          String?               @map("default_owner_id")
  createReceivables       Boolean               @default(true) @map("create_receivables")
  installmentCount        Int?                  @map("installment_count")
  /// Dias após a assinatura para o vencimento da entrada.
  entryDueDays            Int?                  @map("entry_due_days")
  /// Dias após a assinatura para o vencimento da 1ª parcela.
  firstInstallmentDueDays Int?                  @map("first_installment_due_days")
  createBriefing          Boolean               @default(true) @map("create_briefing")
  createProject           Boolean               @default(true) @map("create_project")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wonStage     PipelineStage? @relation(fields: [wonStageId], references: [id], onDelete: SetNull)
  defaultOwner User?          @relation("PostSaleDefaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)

  @@map("post_sale_automation_settings")
}

/// Uma execução da automação para UM contrato. O unique composto é a
/// idempotência de topo: o webhook reenviado N vezes reencontra a MESMA
/// linha em vez de criar N execuções.
model AutomationExecution {
  id             String                    @id @default(cuid())
  organizationId String                    @map("organization_id")
  eventType      AutomationEventType       @map("event_type")
  contractId     String                    @map("contract_id")
  status         AutomationExecutionStatus @default(PENDING)
  triggeredBy    AutomationTrigger         @default(WEBHOOK) @map("triggered_by")
  /// Usuário que pediu o reprocessamento; null quando veio do webhook.
  triggeredById  String?                   @map("triggered_by_id")
  attempts       Int                       @default(0)
  startedAt      DateTime?                 @map("started_at")
  finishedAt     DateTime?                 @map("finished_at")
  /// Resumo do erro fatal (mensagem, sem stack, sem token/PDF/segredo).
  error          String?
  /// Payload seguro do evento: só id/número/status/valor do contrato --
  /// nunca snapshot do contratante, token de assinatura ou PDF.
  payload        Json?
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract        Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  triggeredByUser User?                @relation("AutomationTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  steps           AutomationStep[]
  artifacts       AutomationArtifact[]

  @@unique([organizationId, eventType, contractId])
  @@index([organizationId, status])
  @@index([contractId])
  @@map("automation_executions")
}

model AutomationStep {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  executionId    String               @map("execution_id")
  key            AutomationStepKey
  status         AutomationStepStatus @default(PENDING)
  /// Texto curto pra tela ("Lead já estava ganho", "Sem template configurado").
  detail         String?
  error          String?
  attempts       Int                  @default(0)
  startedAt      DateTime?            @map("started_at")
  finishedAt     DateTime?            @map("finished_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution    AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, key])
  @@index([organizationId])
  @@map("automation_steps")
}

/// Um registro por coisa criada pela automação. `key` é o identificador
/// ESTÁVEL do artefato dentro da execução (ex.: "briefing", "project",
/// "task:kickoff") -- é ele, junto do unique, que garante que reprocessar
/// não cria uma segunda tarefa de kickoff.
///
/// `refId` não é FK: aponta pra tabelas diferentes conforme o `type`. Se a
/// entidade for apagada, o link na tela some (tratado como "não encontrado")
/// em vez de virar FK quebrada ou cascata surpresa.
model AutomationArtifact {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  executionId    String                 @map("execution_id")
  stepKey        AutomationStepKey      @map("step_key")
  key            String
  type           AutomationArtifactType
  refId          String                 @map("ref_id")
  /// Rótulo pra tela (título da tarefa, nome do projeto...).
  label          String?
  createdAt      DateTime               @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution    AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, key])
  @@index([organizationId])
  @@map("automation_artifacts")
}

// ============================================================
// MilSocial (ferramenta interna do dono -- NAO multi-tenant).
// Sem organizationId de proposito: segue o precedente de
// Permission/RolePermission como tabelas globais. NAO adicionar
// relations destes modelos em `model Organization`.
// ============================================================

enum SocialPostFormat {
  UNCLASSIFIED
  REDESIGN
  BEFORE_AFTER
  TIMELAPSE
  REVIEW
  ANIMATION
  CODE_SETUP
  OTHER
}

enum SocialFormatSource {
  NONE
  AI
  MANUAL
}

model SocialPost {
  id           String                 @id @default(cuid())
  igMediaId    String                 @unique
  igPermalink  String
  mediaType    String
  caption      String?                @db.Text
  thumbnailUrl String?
  publishedAt  DateTime
  format       SocialPostFormat       @default(UNCLASSIFIED)
  formatSource SocialFormatSource     @default(NONE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  snapshots    SocialMetricSnapshot[]

  @@index([publishedAt])
}

model SocialMetricSnapshot {
  id               String     @id @default(cuid())
  postId           String
  post             SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  collectedAt      DateTime   @default(now())
  reach            Int?
  views            Int?
  avgWatchTimeMs   Int?
  totalWatchTimeMs BigInt?
  likes            Int?
  comments         Int?
  saved            Int?
  shares           Int?
  profileVisits    Int?
  profileActivity  Int?

  @@unique([postId, collectedAt])
  @@index([collectedAt])
}

model SocialConfig {
  id             String   @id @default("singleton")
  accessToken    String
  tokenExpiresAt DateTime
  updatedAt      DateTime @updatedAt
}

// ===================================================================
// COFRE FINANCEIRO — finanças pessoais do dono da conta
// ===================================================================
//
// Estes modelos quebram, de propósito, a convenção multi-tenant do resto do
// schema: NÃO carregam `organizationId`. O dono é o usuário
// (`ownerUserId`), e é por ele que toda query filtra.
//
// Não é descuido nem atalho: `organizationId` aqui significaria "este dado
// pertence à organização", e é justamente disso que o Cofre precisa não
// participar. Com a coluna, qualquer repositório que filtrasse por tenant
// (o padrão da casa) devolveria dado financeiro pessoal pra quem tem papel
// na organização -- que é exatamente o que o módulo existe pra impedir. A
// autorização do Cofre é posse + sessão elevada, nunca RBAC: ver
// docs/personal-finance-vault.md.

/// Um Cofre por usuário (`ownerUserId` é unique). Não existe "o" Cofre do
/// sistema: existe o SEU. Quem não tem um recebe 404 em toda rota do módulo,
/// igual a quem não é dono do Cofre alheio -- a resposta não distingue os
/// dois casos de propósito.
model PersonalVault {
  id          String  @id @default(cuid())
  ownerUserId String  @unique @map("owner_user_id")
  /// Desligar o Cofre mantém os dados e fecha o acesso (as rotas voltam a
  /// responder 404). Não é exclusão -- ver a exportação antes de apagar.
  enabled     Boolean @default(true)

  /// Tentativas de desbloqueio erradas desde o último acerto. Persistido no
  /// banco, e não num contador em memória, porque a API roda no Render free:
  /// o processo dorme e reinicia sozinho, e um balde em memória devolveria
  /// tentativas de graça a cada cold start -- exatamente quando um atacante
  /// paciente estaria tentando.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastUnlockedAt DateTime? @map("last_unlocked_at")

  /// Corte de sessões elevadas: todo token emitido ANTES deste instante é
  /// recusado. É o que faz "Bloquear agora" e o logout serem revogação de
  /// verdade -- sem isso, um token roubado continuaria válido pelos 15
  /// minutos restantes, e o botão seria só cosmético (limpar o cookie do
  /// navegador não invalida nada no servidor).
  sessionsInvalidatedAt DateTime? @map("sessions_invalidated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  accounts     PersonalAccount[]
  cards        PersonalCreditCard[]
  categories   PersonalCategory[]
  merchants    PersonalMerchant[]
  aliases      PersonalMerchantAlias[]
  transactions PersonalTransaction[]
  splits       PersonalTransactionSplit[]
  statements   PersonalStatement[]
  importBatches   PersonalImportBatch[]
  importProfiles  PersonalImportProfile[]

  @@map("personal_vaults")
}

// -------------------------------------------------------------------
// Cofre Financeiro -- nucleo (fase 2): contas, cartoes, categorias,
// fornecedores, movimentacoes, divisoes e faturas.
//
// Tudo pendura em `vaultId`, nao em `ownerUserId`. Os dois provariam a
// mesma coisa (o Cofre e 1:1 com o usuario), mas `requireVault` so
// preenche `req.vault` DEPOIS de confirmar que aquele Cofre e de quem
// pediu -- entao filtrar pelo `vaultId` e filtrar exatamente pelo que foi
// autorizado, sem uma segunda coluna que alguem possa esquecer de checar.
// -------------------------------------------------------------------

enum PersonalAccountType {
  CHECKING
  SAVINGS
  DIGITAL_WALLET
  /// Carteira "Dinheiro" -- destino dos saques, que sao transferencia, nao gasto.
  CASH

  @@map("personal_account_type")
}

enum PersonalCurrency {
  BRL
  USD
  EUR

  @@map("personal_currency")
}

enum PersonalTransactionDirection {
  IN
  OUT

  @@map("personal_transaction_direction")
}

enum PersonalTransactionSource {
  OFX
  CSV
  MANUAL

  @@map("personal_transaction_source")
}

enum PersonalTransactionStatus {
  PENDING
  CONFIRMED
  IGNORED
  REVERSED

  @@map("personal_transaction_status")
}

enum PersonalSplitKind {
  PERSONAL
  REIMBURSABLE
  BUSINESS

  @@map("personal_split_kind")
}

enum PersonalStatementStatus {
  OPEN
  CLOSED
  PARTIAL
  PAID
  OVERDUE

  @@map("personal_statement_status")
}

/// Conta bancaria, carteira digital ou dinheiro em especie.
///
/// `last4` e o UNICO fragmento de numero guardado -- nunca o numero completo
/// da conta. Serve pra voce distinguir duas contas do mesmo banco na tela, e
/// nada mais; nao ha fluxo aqui que precise do numero inteiro.
model PersonalAccount {
  id          String              @id @default(cuid())
  vaultId     String              @map("vault_id")
  name        String
  institution String?
  type        PersonalAccountType
  currency    PersonalCurrency    @default(BRL)
  last4       String?             @db.VarChar(4)
  /// Saldo INFORMADO por voce, com a data em que informou. Nao e saldo
  /// calculado: sem extrato completo desde a abertura da conta, somar
  /// movimentacoes daria um numero errado com cara de certo.
  reportedBalance   Decimal?  @map("reported_balance") @db.Decimal(14, 2)
  reportedBalanceAt DateTime? @map("reported_balance_at")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  vault        PersonalVault        @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[]
  /// Cartoes que sao pagos por esta conta.
  paidCards    PersonalCreditCard[] @relation("CardPaymentAccount")
  importBatches   PersonalImportBatch[]
  importProfiles  PersonalImportProfile[]

  @@index([vaultId, isActive])
  @@map("personal_accounts")
}

/// Cartao de credito. Guarda `last4`, e mais nada que identifique o plastico:
/// nunca numero completo, validade ou codigo de seguranca -- esses tres juntos
/// sao o que permite uma compra, e nenhum fluxo deste modulo precisa deles.
model PersonalCreditCard {
  id          String   @id @default(cuid())
  vaultId     String   @map("vault_id")
  name        String
  institution String?
  last4       String?  @db.VarChar(4)
  limitAmount Decimal? @map("limit_amount") @db.Decimal(14, 2)
  /// Dia do mes (1-31). Compras depois do fechamento caem na fatura seguinte.
  closingDay Int @map("closing_day")
  dueDay     Int @map("due_day")
  /// Conta usada pra pagar a fatura. SetNull: apagar a conta nao pode levar o
  /// historico do cartao junto.
  paymentAccountId String?  @map("payment_account_id")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vault          PersonalVault         @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  paymentAccount PersonalAccount?      @relation("CardPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  transactions   PersonalTransaction[]
  statements     PersonalStatement[]
  importBatches  PersonalImportBatch[]
  importProfiles PersonalImportProfile[]

  @@index([vaultId, isActive])
  @@map("personal_credit_cards")
}

/// Categoria ou subcategoria (um nivel so de profundidade, garantido no
/// service). Criadas por voce, renomeaveis e desativaveis.
///
/// `systemKey` existe porque o NOME nao serve de identificador: voce pode
/// renomear "Transferencias" pra "Movimentacao interna", e a regra que diz
/// "transferencia nao e gasto" nao pode parar de funcionar por causa disso.
/// Categoria que voce criar do zero tem `systemKey` nulo.
model PersonalCategory {
  id        String  @id @default(cuid())
  vaultId   String  @map("vault_id")
  parentId  String? @map("parent_id")
  name      String
  systemKey String? @map("system_key")
  /// Cor opcional pra leitura rapida nos graficos.
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vault    PersonalVault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  parent   PersonalCategory?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children PersonalCategory[] @relation("CategoryParent")

  transactions PersonalTransaction[]
  splits       PersonalTransactionSplit[]
  merchants    PersonalMerchant[]

  @@unique([vaultId, systemKey])
  @@unique([vaultId, parentId, name])
  @@index([vaultId, isActive])
  @@map("personal_categories")
}

/// Fornecedor normalizado (Claude, iFood, Vercel). O que aparece no extrato
/// sao os aliases; o fornecedor e o nome que voce quer ver no relatorio.
model PersonalMerchant {
  id                String   @id @default(cuid())
  vaultId           String   @map("vault_id")
  name              String
  /// Categoria sugerida quando um alias deste fornecedor casa.
  defaultCategoryId String?  @map("default_category_id")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vault           PersonalVault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  defaultCategory PersonalCategory?       @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  aliases         PersonalMerchantAlias[]
  transactions    PersonalTransaction[]

  @@unique([vaultId, name])
  @@index([vaultId, isActive])
  @@map("personal_merchants")
}

/// Como o fornecedor aparece no extrato: ANTHROPIC, CLAUDE.AI, CLAUDE PRO ->
/// todos apontam pro fornecedor "Claude".
///
/// `alias` e guardado JA NORMALIZADO (maiusculas, sem acento, sem ruido) --
/// normalizar na escrita e o que permite o unique fazer o trabalho de
/// deduplicacao, em vez de depender de toda leitura lembrar de normalizar.
model PersonalMerchantAlias {
  id         String   @id @default(cuid())
  vaultId    String   @map("vault_id")
  merchantId String   @map("merchant_id")
  alias      String
  createdAt  DateTime @default(now()) @map("created_at")

  vault    PersonalVault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  merchant PersonalMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([vaultId, alias])
  @@index([merchantId])
  @@map("personal_merchant_aliases")
}

/// Fatura de cartao. Um mes de referencia por cartao.
model PersonalStatement {
  id      String @id @default(cuid())
  vaultId String @map("vault_id")
  cardId  String @map("card_id")
  /// Primeiro dia do mes de referencia (guardado como data pra ordenar e
  /// comparar sem parsing de string).
  referenceMonth DateTime                @map("reference_month") @db.Date
  closingDate    DateTime                @map("closing_date") @db.Date
  dueDate        DateTime                @map("due_date") @db.Date
  totalAmount    Decimal                 @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount     Decimal                 @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status         PersonalStatementStatus @default(OPEN)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  vault        PersonalVault         @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  card         PersonalCreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[]

  @@unique([cardId, referenceMonth])
  @@index([vaultId, dueDate])
  @@map("personal_statements")
}

/// Uma movimentacao. Vive numa conta OU num cartao, nunca nos dois -- um CHECK
/// no banco garante isso (ver a migration), porque uma linha com os dois nulos
/// nao teria origem e uma com os dois preenchidos seria contada duas vezes.
///
/// Valor SEMPRE positivo, com `direction` explicito. Sinal negativo e ambiguo
/// entre bancos (uns mandam credito negativo, outros debito) e vira erro
/// silencioso de soma; direcao separada nao tem como ser mal lida.
model PersonalTransaction {
  id        String  @id @default(cuid())
  vaultId   String  @map("vault_id")
  accountId String? @map("account_id")
  cardId    String? @map("card_id")

  /// Quando a compra aconteceu (regime de competencia).
  transactionDate DateTime  @map("transaction_date") @db.Date
  /// Quando o dinheiro entrou/saiu de fato (regime de caixa). Nulo enquanto
  /// nao compensou -- as duas visoes precisam de datas separadas, e uma so
  /// coluna forcaria escolher um regime pra sempre.
  settlementDate DateTime? @map("settlement_date") @db.Date

  /// Exatamente como veio do banco. Nunca reescrita: e a prova do que o
  /// extrato dizia quando a classificacao for revista.
  originalDescription String
  /// Versao limpa, usada por regras e pelo fingerprint.
  normalizedDescription String @map("normalized_description")

  merchantId String? @map("merchant_id")
  categoryId String? @map("category_id")

  direction PersonalTransactionDirection
  amount    Decimal                      @db.Decimal(14, 2)
  currency  PersonalCurrency             @default(BRL)
  /// Preenchidos so quando a cobranca veio em outra moeda.
  originalAmount   Decimal?          @map("original_amount") @db.Decimal(14, 2)
  originalCurrency PersonalCurrency? @map("original_currency")
  /// O que efetivamente saiu em reais (ja com IOF/spread). E a coluna que todo
  /// relatorio soma -- converter na leitura reescreveria o passado sempre que
  /// o cambio mudasse.
  amountBrl Decimal @map("amount_brl") @db.Decimal(14, 2)

  source PersonalTransactionSource
  /// Lote de importacao de origem -- a procedencia da linha. SetNull: apagar
  /// o registro do lote nao pode levar as movimentacoes junto.
  importBatchId String? @map("import_batch_id")
  /// FITID do OFX (ou equivalente), como veio.
  externalId String? @map("external_id")
  /// Chave de deduplicacao das importacoes. Quando existe FITID, e derivada
  /// DELE; sem FITID, e derivada de conta+data+valor+direcao+descricao. Um
  /// unique so, duas estrategias -- a prioridade mora em como a chave e
  /// montada, nao em dois indices concorrentes.
  ///
  /// NULA em lancamento manual, de proposito: dois cafes de R$5 no mesmo dia
  /// sao duas despesas reais, e um unique pegaria o segundo como duplicata.
  fingerprint String? @map("fingerprint")

  status PersonalTransactionStatus @default(CONFIRMED)
  note   String?

  statementId       String? @map("statement_id")
  installmentNumber Int?    @map("installment_number")
  installmentTotal  Int?    @map("installment_total")

  /// Transferencia entre contas proprias ou pagamento de fatura: move
  /// dinheiro, mas nao e receita nem despesa. Fica FORA dos totais de consumo
  /// -- ver docs/personal-finance-vault.md.
  isTransfer Boolean @default(false) @map("is_transfer")
  /// Contraparte da transferencia, quando conhecida -- e o que permite nao
  /// contar a mesma movimentacao duas vezes nos dois lados.
  transferPairId String? @unique @map("transfer_pair_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vault     PersonalVault       @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  account   PersonalAccount?    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card      PersonalCreditCard? @relation(fields: [cardId], references: [id], onDelete: Restrict)
  merchant  PersonalMerchant?   @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  category  PersonalCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  statement PersonalStatement?  @relation(fields: [statementId], references: [id], onDelete: SetNull)
  importBatch PersonalImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  splits PersonalTransactionSplit[]

  @@unique([vaultId, fingerprint])
  @@index([vaultId, transactionDate])
  @@index([vaultId, settlementDate])
  @@index([vaultId, status])
  @@index([vaultId, categoryId])
  @@index([vaultId, merchantId])
  @@index([accountId])
  @@index([cardId])
  @@index([statementId])
  @@index([importBatchId])
  @@map("personal_transactions")
}

/// Divisao de uma movimentacao: a compra de R$300 que tem R$100 seu, R$100 que
/// alguem te devolve e R$100 da MilWeb.
///
/// As divisoes sao a UNICA fonte de verdade do rateio -- a transacao nao
/// carrega booleano "e empresarial"/"e reembolsavel". Dois lugares dizendo a
/// mesma coisa e exatamente como nasce contagem dupla, que e o risco numero um
/// deste modulo. Sem divisao nenhuma, a movimentacao e 100% pessoal; com
/// divisoes, o que sobrar do valor continua sendo pessoal.
model PersonalTransactionSplit {
  id            String            @id @default(cuid())
  vaultId       String            @map("vault_id")
  transactionId String            @map("transaction_id")
  kind          PersonalSplitKind
  amount        Decimal           @db.Decimal(14, 2)
  categoryId    String?           @map("category_id")
  note          String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  vault       PersonalVault       @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  transaction PersonalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    PersonalCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([vaultId, kind])
  @@map("personal_transaction_splits")
}

// -------------------------------------------------------------------
// Cofre Financeiro -- importacao (fase 3): lote e perfil de mapeamento.
//
// O ARQUIVO BANCARIO NAO E ARMAZENADO. Nenhuma coluna aqui guarda o
// conteudo: sobram hash, nome higienizado, periodo, formato, contagens e
// erros por numero de linha. Extrato e o documento mais sensivel do Cofre,
// e um arquivo guardado "por precaucao" e um arquivo que pode vazar --
// depois de virar movimentacao, ele nao serve mais pra nada.
// -------------------------------------------------------------------

enum PersonalImportFormat {
  OFX
  CSV

  @@map("personal_import_format")
}

enum PersonalImportStatus {
  /// Todas as linhas validas viraram movimentacao.
  COMPLETED
  /// Parte entrou; o resto era duplicata ou linha invalida.
  PARTIAL
  /// Nada entrou (arquivo ilegivel ou nenhuma linha aproveitavel).
  FAILED

  @@map("personal_import_status")
}

/// Registro do que foi importado -- a prova de procedencia de cada
/// movimentacao vinda de arquivo.
model PersonalImportBatch {
  id      String @id @default(cuid())
  vaultId String @map("vault_id")
  /// Origem: conta OU cartao (CHECK no banco, igual a movimentacao).
  accountId String? @map("account_id")
  cardId    String? @map("card_id")

  format PersonalImportFormat
  /// SHA-256 do conteudo. Serve pra reconhecer o MESMO arquivo reenviado --
  /// e o unico proposito; nao da pra reconstruir nada a partir dele.
  fileHash String @map("file_hash")
  /// Nome higienizado (sem caminho, sem caractere de controle). O nome
  /// original de um extrato costuma carregar agencia e conta.
  fileName String @map("file_name")

  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  totalRows     Int @default(0) @map("total_rows")
  importedRows  Int @default(0) @map("imported_rows")
  duplicateRows Int @default(0) @map("duplicate_rows")
  ignoredRows   Int @default(0) @map("ignored_rows")

  status PersonalImportStatus
  /// Erros SEGUROS: `[{ line, code }]`. Nunca a descricao bancaria, nunca o
  /// valor -- um log de importacao com o conteudo do extrato seria o extrato
  /// de volta, por outra porta.
  errors Json?

  createdAt DateTime @default(now()) @map("created_at")

  vault        PersonalVault         @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  account      PersonalAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card         PersonalCreditCard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  transactions PersonalTransaction[]

  @@index([vaultId, createdAt])
  @@index([vaultId, fileHash])
  @@map("personal_import_batches")
}

/// Modelo de leitura de CSV salvo por banco/cartao.
///
/// Existe porque CSV de banco nao tem padrao: cada um escolhe separador,
/// formato de data, virgula ou ponto decimal, e se debito vem negativo ou em
/// coluna propria. Remapear as colunas toda vez seria o tipo de atrito que
/// faz a pessoa parar de importar.
model PersonalImportProfile {
  id      String @id @default(cuid())
  vaultId String @map("vault_id")
  name    String

  accountId String? @map("account_id")
  cardId    String? @map("card_id")

  format PersonalImportFormat @default(CSV)
  /// Caractere separador (`,`, `;` ou tab).
  delimiter String @default(",")
  /// `,` ou `.` -- extrato brasileiro costuma usar virgula.
  decimalSeparator String @default(",") @map("decimal_separator")
  /// `DMY`, `MDY` ou `YMD`. Guardado como ordem, e nao como mascara literal,
  /// porque o que muda entre bancos e a ORDEM; o separador varia demais pra
  /// valer a pena fixar.
  dateOrder String  @default("DMY") @map("date_order")
  hasHeader Boolean @default(true) @map("has_header")

  /// De qual coluna sai cada campo: `{ date, description, amount, debit,
  /// credit, externalId }`. Indice numerico ou nome do cabecalho.
  columnMap Json @map("column_map")

  /// Alguns bancos mandam despesa como positivo. Inverter aqui e melhor que
  /// pedir pra pessoa "lembrar" na hora de conferir.
  invertSign Boolean @default(false) @map("invert_sign")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vault   PersonalVault       @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  account PersonalAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card    PersonalCreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([vaultId, name])
  @@index([vaultId])
  @@map("personal_import_profiles")
}
