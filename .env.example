# ===== Infra (nuvem: Supabase + Upstash -- setup padrão, sem Docker) =====
# Supabase: use a connection string do SESSION POOLER (Dashboard > Connect),
# que funciona com Prisma e com redes IPv4. Caracteres especiais na senha
# precisam de URL-encoding (ex.: $ -> %24, # -> %23).
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?schema=public"
# Upstash exige TLS -- por isso rediss:// (dois "s"), não redis://.
REDIS_URL="rediss://default:SUA_SENHA@SEU-HOST.upstash.io:6379"

# Alternativa local com Docker (docker compose up -d):
# DATABASE_URL="postgresql://millead:millead@localhost:5432/millead?schema=public"
# REDIS_URL="redis://localhost:6379"

# ===== Auth =====
# Refresh token é opaco (não é JWT) -- só o access token usa segredo.
# Gere um de verdade fora de dev local, ex.: openssl rand -base64 48
JWT_ACCESS_SECRET="troque-este-segredo-por-um-de-verdade-com-32-chars-ou-mais"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ===== API =====
NODE_ENV="development"
API_PORT="4000"
CORS_ORIGIN="http://localhost:3000"
# Nº de proxies confiáveis à frente da API (Render/Vercel = 1). NÃO usar
# valor alto/true: senão o X-Forwarded-For do cliente burla o rate-limit.
TRUST_PROXY_HOPS="1"

# ===== IA (Fase 7 -- opcional) =====
# Sem a chave o app funciona normalmente, mas score/mensagens/relatorios de IA
# ficam desabilitados (503 amigavel + botoes desativados na UI).
# Provedor gratuito (recomendado): API da NVIDIA com o Nemotron 3.5 Lightning.
# Crie a chave em https://build.nvidia.com (conta gratis, botao "Get API Key").
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"   # qualquer API no formato OpenAI serve (OpenRouter, vLLM...)
#
# Provedor pago: Anthropic (Claude). Crie em https://console.anthropic.com.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-opus-5"
#
# Com as duas chaves, a NVIDIA ganha; force com AI_PROVIDER="anthropic" | "nvidia".
# AI_PROVIDER="nvidia"

# ===== Contratos (Fase 9 -- tudo opcional; padrao = assinatura simulada) =====
# APP_PUBLIC_URL="http://localhost:4000"      # URL publica da API (webhooks)
# SIGNATURE_PROVIDER="mock"                    # mock | zapsign
# ZAPSIGN_API_TOKEN=""
# ZAPSIGN_WEBHOOK_SECRET=""
# ZAPSIGN_SANDBOX="true"
# Dados da contratada impressos nos contratos (snapshot juridico):
# CONTRACTOR_RAZAO_SOCIAL="MilWeb Desenvolvimento"
# CONTRACTOR_CNPJ="00.000.000/0001-00"
# CONTRACTOR_ENDERECO="Rua X, 123, Cidade - UF"
# CONTRACTOR_EMAIL="contato@milweb.com.br"
# CONTRACTOR_FORO="Comarca de Sua Cidade - UF"
# E-mail (sem SMTP_HOST, envio vira no-op):
# SMTP_HOST="" SMTP_PORT="587" SMTP_USER="" SMTP_PASS="" SMTP_FROM="" OWNER_EMAIL=""
# WhatsApp Meta Cloud API (opt-in):
# WHATSAPP_ENABLED="false" WHATSAPP_PHONE_ID="" WHATSAPP_TOKEN=""

# ===== Briefings (Fase 10) =====
# Vercel Blob -- storage dos anexos do briefing (galeria, PDF gerado) e
# upload direto do browser pro Blob (client token). Obrigatória: sem ela o
# módulo de Briefings não sobe (crie um store em vercel.com/dashboard/stores
# ou `vercel blob create-store` na raiz do projeto vinculado).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# URL pública do web (monta o link /b/:token em e-mail/WhatsApp) -- distinta
# de APP_PUBLIC_URL acima, que é a URL pública da própria API.
# WEB_PUBLIC_URL="http://localhost:3000"

# ===== MilSocial (ferramenta interna do dono) =====
# Token de longa duração do Instagram (gerado via Meta Developers).
# Renovação automática ocorre após o primeiro sync (persiste em SocialConfig).
# INSTAGRAM_ACCESS_TOKEN="cole-aqui-o-long-lived-token-do-instagram"
# Chave para autorizar o cron do GitHub Actions sem sessão de usuário. Precisa
# ser IDÊNTICA ao secret MILSOCIAL_SYNC_KEY do repositório (Settings > Secrets
# and variables > Actions) -- se divergirem, o sync diário responde 401.
# Gere com: openssl rand -hex 24
# MILSOCIAL_SYNC_KEY="gere-com-openssl-rand-hex-24"

# Chave para as skills do Claude Code (site-institucional/sistema-web)
# sincronizarem o checklist de projetos sem sessão de usuário. Opcional --
# sem ela, a sincronização automática fica desativada (o painel continua
# funcionando normalmente por login).
# Gere com: openssl rand -hex 24
# AUTOMATION_API_KEY="gere-com-openssl-rand-hex-24"
# AUTOMATION_ORGANIZATION_ID="cole-aqui-o-id-da-organizacao-milweb"

# ===== Web =====
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# E-mail do dono (para autorização no painel MilSocial).
# NEXT_PUBLIC_OWNER_EMAIL="rick@milweb.com.br"

# ===== Cofre Financeiro (financas pessoais do dono da conta) =====
# Segredo PROPRIO da sessao elevada do Cofre. Precisa ser DIFERENTE de
# JWT_ACCESS_SECRET -- a API recusa subir em producao com os dois iguais.
# Gere com: openssl rand -base64 48
# SEM esta variavel o modulo inteiro responde 404 (fecha, nao degrada).
# VAULT_SESSION_SECRET=""
# Inatividade tolerada antes de o Cofre se fechar sozinho.
# VAULT_SESSION_TTL="15m"
